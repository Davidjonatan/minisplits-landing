---
import Layout from '../layouts/Layout.astro';
import Carousel from '../components/Carousel.astro';
import GroupServices from '../components/GroupServices.astro';
import FinalBooking from '../components/FinalBooking.astro';
---

<Layout title="Servicios Técnicos | Minisplits, Aires Evaporativos y Electricidad">
  <!-- 1. Sección Inicio (Hero + Carousel) -->
  <section id="inicio">
    <Carousel />
  </section>

  <!-- 2. Sección Servicios (Formularios Paso 1) -->
  <section id="servicios" class="bg-slate-100 border-t border-slate-200 shadow-inner">
    <GroupServices />
  </section>

  <!-- 3. Sección Agendar (Formulario Final Paso 2) -->
  <section id="agendar" class="bg-slate-50 border-t border-slate-200">
    <FinalBooking />
  </section>

  <!-- Banner de Confianza -->
  <section class="bg-white py-12 px-4 border-t border-slate-200 shadow-sm relative z-10">
    <div class="max-w-4xl mx-auto text-center">
      <h3 class="text-2xl font-bold mb-4 text-slate-800">¿Por qué elegir nuestro servicio técnico?</h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-center mt-8">
        <div>
          <div class="font-bold text-blue-600 text-xl">✓ Respuesta Rápida</div>
          <p class="text-sm text-slate-600 mt-1">Atención y diagnóstico oportuno para tu comodidad.</p>
        </div>
        <div>
          <div class="font-bold text-blue-600 text-xl">✓ Trabajo Garantizado</div>
          <p class="text-sm text-slate-600 mt-1">Refacciones y mano de obra con respaldo de calidad.</p>
        </div>
        <div>
          <div class="font-bold text-blue-600 text-xl">✓ Cotizaciones Claras</div>
          <p class="text-sm text-slate-600 mt-1">Sin costos ocultos ni sorpresas en tu cobro.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>